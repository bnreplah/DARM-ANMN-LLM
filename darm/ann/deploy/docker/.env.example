# Must match DARM_CHAIN_NAME on the mesh nodes.
DARM_CHAIN_NAME=my-darm-mesh
# Comma-separated validator node ids (hex), identical to DARM_VALIDATORS on the
# mesh nodes. Get each id from the node's `darm_status` or `darm-node keygen`.
DARM_VALIDATORS=
# Feature activation heights, identical to DARM_ACTIVATE on the mesh nodes
# (e.g. credits@1200,evidence@1200). Leave empty while the mesh has none.
DARM_ACTIVATE=
RUST_LOG=info
